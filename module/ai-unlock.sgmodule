[Panel]
ai-unlock = title="AI 与流媒体解锁检测",content="点击刷新检测",style=info,script-name=ai-unlock,update-interval=-1

[Script]
ai-unlock = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/wellyang008/sgmodule/main/js/ai_unlock.js
