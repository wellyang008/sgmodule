#!name=AI 与海外媒体解锁检测
#!desc=检测 Claude、Gemini、OpenAI、YouTube、Netflix、Disney+、Spotify 与 TikTok 的网站可访问性

[Panel]
AI-Media-Check = title="AI / 海外媒体检测",content="点击刷新检测",style=info,script-name=ai-unlock,update-interval=3600

[Script]
ai-unlock = type=generic,timeout=45,script-path=https://raw.githubusercontent.com/wellyang008/sgmodule/main/js/ai_unlock.js?v=20261123-20,script-update-interval=3600
